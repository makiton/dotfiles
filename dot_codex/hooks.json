{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/git-sync-main.sh\"",
            "statusMessage": "Syncing default branch from origin"
          }
        ]
      }
    ]
  }
}

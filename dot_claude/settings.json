{
  "autoMode": true,
  "defaultMode": "acceptEdits",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(gh pr:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(gh run:*)",
      "Bash(grep -v \"^\\\\s*$\")",
      "Bash(pnpm biome:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  }
}
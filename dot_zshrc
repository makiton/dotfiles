# --- Basics ---
bindkey -e
export EDITOR=vim

# Locale settings (Resilient)
if locale -a 2>/dev/null | grep -q "ja_JP.utf8"; then
  export LC_ALL=ja_JP.UTF-8
  export LANG=ja_JP.UTF-8
else
  export LC_ALL=C.UTF-8
  export LANG=C.UTF-8
fi

# --- Zsh Options ---
setopt AUTO_CD
setopt prompt_subst
setopt hist_ignore_dups
setopt EXTENDED_HISTORY

cdpath=(.. ~ ~/workspace)

# --- History ---
export HISTFILE=~/.zsh_history
export HISTSIZE=1000
export SAVEHIST=100000

# --- Aliases ---
alias ll="ls -al"
alias be="bundle exec"

# --- Prompt / VCS Info ---
autoload -Uz vcs_info
zstyle ':vcs_info:*' formats '%F{green}%b%f'
zstyle ':vcs_info:*' actionformats '%F{green}%b%f(%F{red}%a%f)'
function precmd() {
  vcs_info
}
PROMPT='${vcs_info_msg_0_}:%~/%% '

# --- Peco / ghq ---
function peco-src() {
  local selected_dir=$(ghq list -p | peco --query "$LBUFFER")
  if [ -n "$selected_dir" ]; then
    BUFFER="cd ${selected_dir}"
    zle accept-line
  fi
  zle clear-screen
}
zle -N peco-src
bindkey '^]' peco-src

# --- PATH & Shell Environment ---

# Homebrew
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  fpath=($(brew --prefix)/share/zsh/site-functions $fpath)
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
  fpath=($(brew --prefix)/share/zsh/site-functions $fpath)
fi

# Completions
autoload -U compinit
compinit -u

# Core Paths
path=(
  $HOME/.local/bin
  $HOME/go/bin
  /usr/local/go/bin
  /snap/bin
  $path
)

# Language Specific PATHs (Manual)
[ -d "/opt/homebrew/opt/ruby/bin" ] && export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
[ -d "/opt/homebrew/opt/mysql-client/bin" ] && export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
[ -d "/opt/homebrew/opt/mysql-client@8.0/bin" ] && export PATH="/opt/homebrew/opt/mysql-client@8.0/bin:$PATH"

# --- Tool Integrations ---

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# asdf
[ -f "/opt/homebrew/opt/asdf/libexec/asdf.sh" ] && source /opt/homebrew/opt/asdf/libexec/asdf.sh

# pyenv
if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
fi

# direnv
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Java
if [ -x /usr/libexec/java_home ]; then
  export JAVA_HOME=$(/usr/libexec/java_home -v 1.8 2>/dev/null)
fi

# Google Cloud SDK
if [ -f "$HOME/.gcloud/path.zsh.inc" ]; then . "$HOME/.gcloud/path.zsh.inc"; fi
if [ -f "$HOME/.gcloud/completion.zsh.inc" ]; then . "$HOME/.gcloud/completion.zsh.inc"; fi
if [ -f "/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc" ]; then
  source "/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc"
fi

# Docker Machine
command -v docker-machine >/dev/null 2>&1 && eval $(docker-machine env default)

# --- Platform Specific ---

# ssh-agent on Windows (WSL)
if [ -f '/mnt/c/Users/makit/wsl-ssh-agent/npiperelay.exe' ]; then
  export SSH_AUTH_SOCK=$HOME/.ssh/agent.sock
  if ! ss -a | grep -q $SSH_AUTH_SOCK; then
    rm -f $SSH_AUTH_SOCK
    (setsid socat UNIX-LISTEN:$SSH_AUTH_SOCK,fork EXEC:"/mnt/c/Users/makit/wsl-ssh-agent/npiperelay.exe -ei -s //./pipe/openssh-ssh-agent",nofork &) >/dev/null 2>&1
  fi
fi

# --- Final Actions ---

# Auto-start tmux
if command -v tmux >/dev/null 2>&1 && [ -z "$TMUX" ]; then
    tmux attach-session -t default || tmux new-session -s default
fi

source "$HOME/.zsh/mise"
